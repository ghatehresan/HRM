APP_NAME="GhatehResan HRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database — MySQL/MariaDB on ALL environments (XAMPP included).
# SQLite is intentionally NOT used for development: behavior must be
# identical from local XAMPP to production (see AUDIT.md §22.5 X-7).
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ------------------------------------------------------------------
# NOTE: Redis/Memcached are intentionally unsupported.
# XAMPP and most shared hosts do not ship them (AUDIT.md §22.5 X-1).
# Cache, session and queue MUST run on the `database` driver.
# ------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hr@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# HRM — display timezone for Jalali/Persian rendering.
# Storage is ALWAYS UTC; this only affects presentation.
# ------------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Tehran

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# HRM Auth (M2) — see AUTHENTICATION.md.
# ------------------------------------------------------------------
# Password hashing: argon2id (preferred) or bcrypt (fallback).
# Auto-detected when empty; set explicitly to pin one driver.
HASH_DRIVER=argon2id

# MUST be true on staging/production (HTTPS). Keep false for local
# XAMPP over plain http://localhost, otherwise the session cookie
# is never sent and login silently fails.
SESSION_SECURE_COOKIE=false

# Dev-only admin seeding (database/seeders/DevAdminSeeder.php).
# Honored ONLY when APP_ENV=local. Leave ADMIN_PASSWORD empty to get
# a random printed password; CI/E2E sets both explicitly.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=
